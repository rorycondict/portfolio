{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "rorycondict.com",
      "custom_domain": true
    },
    {
      "pattern": "www.rorycondict.com",
      "custom_domain": true
    }
  ]
}